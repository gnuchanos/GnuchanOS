# ============================================================================
#  GnuchanOS  .  Embed demo  .  main.gcsf   --   the REFEREE
# ----------------------------------------------------------------------------
#  This file is GCL.  It is the host of the match and it owns THE BALL.
#
#  It never draws anything.  What it does is run one shared playfield of
#  1600 x 600 that is cut in half:
#
#        virtual x =    0 ..  800  ->  the LUA window     (scripts/main.lua)
#        virtual x =  800 .. 1600  ->  the PYTHON window  (scripts/main.py)
#
#  and every frame it pushes the ball's x/y into the Embed shared state with
#  Embed.SendValue.  The two windows read that state and answer with their own
#  AI paddle position, which this loop reads back with Embed.GetValue and
#  collides the ball against.  So the ball really does travel from one window
#  into the other: it leaves the right edge of the Lua window and appears at
#  the left edge of the Python window, because both are drawing the same ball
#  of the same playfield from two different origins.
#
#      Embed.Run(type="lua")        -> spawns gcl -luarun scripts/main.lua
#      Embed.Run(type="python")     -> spawns gcl -pyrun  scripts/main.py
#      Embed.SendValue(...)         -> ball_x, ball_y, rally, scores, ...
#      Embed.GetValue(...)          -> lua_paddle_y, py_paddle_y, quit
#
#  Run it from the repository root against a built tree:
#
#      language\build\windows\gcl.exe -run language\examples\demo_pong_lua_vs_python\main.gcsf
# ============================================================================

#native <Stdio>
#native <Embed>
#native <Math>

#define FIELD_W        1600      /* the shared virtual playfield, in px       */
#define FIELD_H        600
#define SEAM           800       /* the boundary between the two courts       */
#define BALL_R         10
#define PADDLE_W       18
#define PADDLE_H       96
#define LUA_PADDLE_X   36        /* Lua defends the LEFT wall  (virtual x 0)  */
#define PY_PADDLE_X    1546      /* Python defends the RIGHT wall (x 1600)    */
#define BASE_SPEED_X   380.0
#define BASE_SPEED_Y   130.0
#define MAX_SPEED_X    780.0
#define MAX_SPEED_Y    620.0
#define SPEEDUP_X      1.015     /* the ball sharpens up on every return      */
#define SPEEDUP_Y      1.06
#define WIN_SCORE      7
#define SERVE_WAIT     45        /* ~0.75 s the ball hangs before it is live  */
#define WIN_HOLD       180       /* ~3 s the winner banner stays up           */
#define DT             0.016     /* the referee's fixed simulation step       */
#define MAX_FRAMES     200000    /* ~55 min backstop, far below the GCL       */
                                 /* interpreter's 1,000,000 iteration guard   */
#define HANDSHAKE_MAX  600       /* 30 s for both windows to open             */

/* ---------------------------------------------------------------------------
 *  Small helpers.  They touch no global state, so they are safe to call
 *  from main and can never be confused by the shared-store traffic.
 * ------------------------------------------------------------------------- */
double sign_of(double v) {
    if (v < 0.0) {
        return -1.0;
    }
    return 1.0;
}

double clamp_f(double v, double lo, double hi) {
    if (v < lo) {
        return lo;
    }
    if (v > hi) {
        return hi;
    }
    return v;
}

int main() {
    Stdio.printf("\n");
    Stdio.printf("=================================================================\n");
    Stdio.printf("  GnuchanOS Embed demo   LUA  vs  PYTHON\n");
    Stdio.printf("  one ball, two windows, two languages, one playfield\n");
    Stdio.printf("=================================================================\n");
    Stdio.printf("  main.gcsf (this file, GCL) is the referee and owns the ball.\n");
    Stdio.printf("  The Lua window runs scripts/main.lua (LuaRaylib), the Python\n");
    Stdio.printf("  window runs scripts/main.py (PyRaylib).  Each window owns its\n");
    Stdio.printf("  own AI paddle and draws its own language's colours.\n");
    Stdio.printf("  The ball position travels over Embed.SendValue / GetValue.\n\n");

    /* -----------------------------------------------------------------
     *  Match state.  Every GCL value is a double, so the ball is one.
     * ---------------------------------------------------------------- */
    double ball_x = 400.0;
    double ball_y = 300.0;
    double ball_vx = 0.0;
    double ball_vy = 0.0;
    double pending_vx = BASE_SPEED_X;
    double pending_vy = 60.0;
    double lua_paddle_y = FIELD_H / 2.0;
    double py_paddle_y = FIELD_H / 2.0;

    int lua_score = 0;
    int py_score = 0;
    int rally = 0;
    int serve_wait = 90;          /* open with a 1.5 s "GET READY"             */
    int winner = 0;               /* 0 = nobody, 1 = Lua took it, 2 = Python   */
    int win_hold = 0;
    int running = 1;
    int frame = 0;

    /* -----------------------------------------------------------------
     *  Reset the shared store.  A previous run may have left quit=1 or a
     *  stale score behind, so every key this demo uses is written here,
     *  BEFORE the windows are launched.
     * ---------------------------------------------------------------- */
    Embed.SendValue(type="lua", name="running", value=1);
    Embed.SendValue(type="lua", name="quit", value=0);
    Embed.SendValue(type="lua", name="lua_ready", value=0);
    Embed.SendValue(type="lua", name="lua_hits", value=0);
    Embed.SendValue(type="lua", name="lua_paddle_y", value=300);
    Embed.SendValue(type="lua", name="ball_x", value=ball_x);
    Embed.SendValue(type="lua", name="ball_y", value=ball_y);
    Embed.SendValue(type="lua", name="ball_vx", value=0);
    Embed.SendValue(type="lua", name="ball_vy", value=0);
    Embed.SendValue(type="lua", name="rally", value=0);
    Embed.SendValue(type="lua", name="lua_score", value=0);
    Embed.SendValue(type="lua", name="py_score", value=0);
    Embed.SendValue(type="lua", name="serve_wait", value=serve_wait);
    Embed.SendValue(type="lua", name="winner", value=0);

    Embed.SendValue(type="python", name="running", value=1);
    Embed.SendValue(type="python", name="quit", value=0);
    Embed.SendValue(type="python", name="py_ready", value=0);
    Embed.SendValue(type="python", name="py_hits", value=0);
    Embed.SendValue(type="python", name="py_paddle_y", value=300);
    Embed.SendValue(type="python", name="ball_x", value=ball_x);
    Embed.SendValue(type="python", name="ball_y", value=ball_y);
    Embed.SendValue(type="python", name="ball_vx", value=0);
    Embed.SendValue(type="python", name="ball_vy", value=0);
    Embed.SendValue(type="python", name="rally", value=0);
    Embed.SendValue(type="python", name="lua_score", value=0);
    Embed.SendValue(type="python", name="py_score", value=0);
    Embed.SendValue(type="python", name="serve_wait", value=serve_wait);
    Embed.SendValue(type="python", name="winner", value=0);

    /* -----------------------------------------------------------------
     *  Launch both runtimes.  Each becomes its own gcl process through
     *  -luarun / -pyrun, with its own raylib window; they inherit
     *  GCL_SHARED_FILE, so all three processes share one store.
     * ---------------------------------------------------------------- */
    Stdio.printf("[referee] starting the Lua runtime   (scripts/main.lua)\n");
    if (Embed.Run(type="lua") < 0.5) {
        Stdio.printf("[referee] ERROR: could not start the Lua runtime.\n");
        return 1;
    }
    Stdio.printf("[referee] starting the Python runtime (scripts/main.py)\n");
    if (Embed.Run(type="python") < 0.5) {
        Stdio.printf("[referee] ERROR: could not start the Python runtime.\n");
        Embed.Stop(type="lua");
        return 1;
    }

    /* -----------------------------------------------------------------
     *  Handshake.  Wait until BOTH windows have opened and announced
     *  themselves; otherwise the opening frames would collide the ball
     *  against two paddles still parked at y = 0.
     * ---------------------------------------------------------------- */
    {
        int tries = 0;
        int lua_up = 0;
        int py_up = 0;
        while (tries < HANDSHAKE_MAX && (lua_up == 0 || py_up == 0)) {
            if (Embed.GetValue(type="lua", name="lua_ready") > 0.5) {
                lua_up = 1;
            }
            if (Embed.GetValue(type="python", name="py_ready") > 0.5) {
                py_up = 1;
            }
            if (lua_up == 0 || py_up == 0) {
                Stdio.sleep(0.05);
                tries = tries + 1;
            }
        }
        if (lua_up == 0 || py_up == 0) {
            Stdio.printf("[referee] ERROR: the courts did not come up");
            Stdio.printf(" (lua={} python={}).\n", lua_up, py_up);
            Stdio.printf("[referee] Check that Library/Embed and the Lua/Python\n");
            Stdio.printf("[referee] runtimes exist next to the gcl executable.\n");
            Embed.SendValue(type="lua", name="running", value=0);
            Embed.SendValue(type="python", name="running", value=0);
            Embed.Stop(type="lua");
            Embed.Stop(type="python");
            return 1;
        }
        Stdio.printf("[referee] both courts are up after {} polls.\n", tries);
    }
    Stdio.printf("[referee] match on: first to {} points.\n", WIN_SCORE);
    Stdio.printf("[referee] close either window (or press ESC in it) to end.");
    Stdio.printf(" The referee never opens a window of its own.\n\n");
/* -----------------------------------------------------------------
     *  The match loop.
     *
     *  The period is a hard 16 ms sleep and not a rendering frame,
     *  because the referee has no window of its own; that keeps the
     *  simulation at a steady ~60 Hz for both courts, holds the two
     *  windows in step, and burns no CPU while it waits.
     *
     *  The sleep must be Stdio.sleep and NOT Raylib.WaitTime: raylib's
     *  clock starts in InitWindow, and this process never opens a
     *  window, so GetTime() stays 0.0 and WaitTime() never returns --
     *  the whole match would sit frozen on "GET READY" forever.
     * ---------------------------------------------------------------- */
    while (running == 1 && frame < MAX_FRAMES) {
        frame = frame + 1;

        /* ---- 1. ask both courts where their paddles are --------------- */
        lua_paddle_y = Embed.GetValue(type="lua", name="lua_paddle_y");
        py_paddle_y = Embed.GetValue(type="python", name="py_paddle_y");
        if (lua_paddle_y < 1.0) {
            lua_paddle_y = FIELD_H / 2.0;
        }
        if (py_paddle_y < 1.0) {
            py_paddle_y = FIELD_H / 2.0;
        }
        lua_paddle_y = clamp_f(lua_paddle_y, PADDLE_H / 2.0, FIELD_H - PADDLE_H / 2.0);
        py_paddle_y = clamp_f(py_paddle_y, PADDLE_H / 2.0, FIELD_H - PADDLE_H / 2.0);

        /* ---- 2. advance the ball -------------------------------------- */
        if (win_hold > 0) {
            /* the match has just been decided: hold the winning frame so
               both windows can show the banner */
            ball_vx = 0.0;
            ball_vy = 0.0;
            win_hold = win_hold - 1;
            if (win_hold == 0) {
                lua_score = 0;
                py_score = 0;
                winner = 0;
                rally = 0;
                ball_x = 400.0;
                ball_y = 300.0;
                pending_vx = BASE_SPEED_X;
                pending_vy = Math.randFloat(-90.0, 90.0);
                serve_wait = SERVE_WAIT;
            }
        } else if (serve_wait > 0) {
            /* the ball hangs on the serve spot, then it is released */
            ball_vx = 0.0;
            ball_vy = 0.0;
            serve_wait = serve_wait - 1;
            if (serve_wait == 0) {
                ball_vx = pending_vx;
                ball_vy = pending_vy;
            }
        } else {
            ball_x = ball_x + ball_vx * DT;
            ball_y = ball_y + ball_vy * DT;

            /* the two long walls */
            if (ball_y - BALL_R <= 0.0) {
                ball_y = BALL_R;
                ball_vy = -ball_vy;
            }
            if (ball_y + BALL_R >= FIELD_H) {
                ball_y = FIELD_H - BALL_R;
                ball_vy = -ball_vy;
            }

            /* ---- the LUA paddle (left wall).
               The paddle is only a legal target while the ball is coming
               AT it and has not already slipped behind it -- that window
               is what makes a point possible at all. ---------------- */
            if (ball_vx < 0.0
                && ball_x - BALL_R <= LUA_PADDLE_X + PADDLE_W
                && ball_x - BALL_R >= LUA_PADDLE_X - 14.0
                && ball_y >= lua_paddle_y - PADDLE_H / 2.0 - BALL_R
                && ball_y <= lua_paddle_y + PADDLE_H / 2.0 + BALL_R) {
                double off = (ball_y - lua_paddle_y) / (PADDLE_H / 2.0);
                ball_x = LUA_PADDLE_X + PADDLE_W + BALL_R;
                ball_vx = -ball_vx * SPEEDUP_X;
                ball_vx = clamp_f(ball_vx, 0.0, MAX_SPEED_X);
                ball_vy = clamp_f(ball_vy * SPEEDUP_Y + off * 150.0,
                                  -MAX_SPEED_Y, MAX_SPEED_Y);
                rally = rally + 1;
            }

            /* ---- the PYTHON paddle (right wall) -------------------- */
            if (ball_vx > 0.0
                && ball_x + BALL_R >= PY_PADDLE_X
                && ball_x + BALL_R <= PY_PADDLE_X + PADDLE_W + 14.0
                && ball_y >= py_paddle_y - PADDLE_H / 2.0 - BALL_R
                && ball_y <= py_paddle_y + PADDLE_H / 2.0 + BALL_R) {
                double off2 = (ball_y - py_paddle_y) / (PADDLE_H / 2.0);
                ball_x = PY_PADDLE_X - BALL_R;
                ball_vx = -ball_vx * SPEEDUP_X;
                ball_vx = clamp_f(ball_vx, -MAX_SPEED_X, 0.0);
                ball_vy = clamp_f(ball_vy * SPEEDUP_Y + off2 * 150.0,
                                  -MAX_SPEED_Y, MAX_SPEED_Y);
                rally = rally + 1;
            }

            /* ---- the goals ---------------------------------------- */
            if (ball_x - BALL_R <= 0.0) {
                /* the ball beat the Lua paddle and reached the left wall */
                py_score = py_score + 1;
                Stdio.printf("[referee] point to PYTHON, past the Lua paddle.");
                Stdio.printf("  LUA {} : {} PYTHON\n", lua_score, py_score);
                ball_x = 1150.0;
                ball_y = 220.0 + Math.randFloat(0.0, 160.0);
                pending_vx = -BASE_SPEED_X;
                pending_vy = Math.randFloat(-BASE_SPEED_Y, BASE_SPEED_Y);
                rally = 0;
                serve_wait = SERVE_WAIT;
            } else if (ball_x + BALL_R >= FIELD_W) {
                /* the ball beat the Python paddle and reached the right wall */
                lua_score = lua_score + 1;
                Stdio.printf("[referee] point to LUA, past the Python paddle.");
                Stdio.printf("  LUA {} : {} PYTHON\n", lua_score, py_score);
                ball_x = 450.0;
                ball_y = 220.0 + Math.randFloat(0.0, 160.0);
                pending_vx = BASE_SPEED_X;
                pending_vy = Math.randFloat(-BASE_SPEED_Y, BASE_SPEED_Y);
                rally = 0;
                serve_wait = SERVE_WAIT;
            }

            /* ---- has anybody taken the match? --------------------- */
            if (lua_score >= WIN_SCORE && winner == 0) {
                winner = 1;
                win_hold = WIN_HOLD;
                Stdio.printf("[referee] *** LUA WINS THE MATCH {} : {} ***\n",
                             lua_score, py_score);
            } else if (py_score >= WIN_SCORE && winner == 0) {
                winner = 2;
                win_hold = WIN_HOLD;
                Stdio.printf("[referee] *** PYTHON WINS THE MATCH {} : {} ***\n",
                             lua_score, py_score);
            }
        }

        /* ---- 3. hand the ball to both courts -------------------------- */
        Embed.SendValue(type="lua", name="ball_x", value=ball_x);
        Embed.SendValue(type="lua", name="ball_y", value=ball_y);
        Embed.SendValue(type="lua", name="ball_vx", value=ball_vx);
        Embed.SendValue(type="lua", name="ball_vy", value=ball_vy);
        Embed.SendValue(type="lua", name="rally", value=rally);
        Embed.SendValue(type="lua", name="lua_score", value=lua_score);
        Embed.SendValue(type="lua", name="py_score", value=py_score);
        Embed.SendValue(type="lua", name="serve_wait", value=serve_wait);
        Embed.SendValue(type="lua", name="winner", value=winner);

        Embed.SendValue(type="python", name="ball_x", value=ball_x);
        Embed.SendValue(type="python", name="ball_y", value=ball_y);
        Embed.SendValue(type="python", name="ball_vx", value=ball_vx);
        Embed.SendValue(type="python", name="ball_vy", value=ball_vy);
        Embed.SendValue(type="python", name="rally", value=rally);
        Embed.SendValue(type="python", name="lua_score", value=lua_score);
        Embed.SendValue(type="python", name="py_score", value=py_score);
        Embed.SendValue(type="python", name="serve_wait", value=serve_wait);
        Embed.SendValue(type="python", name="winner", value=winner);

        /* ---- 4. a heartbeat on the console every 2 s ----------------- */
        if (frame % 120 == 0) {
            Stdio.printf("[referee] frame {}  ball x={.2f} y={.2f}  rally {}",
                         frame, ball_x, ball_y, rally);
            Stdio.printf("  LUA {} : {} PYTHON\n", lua_score, py_score);
        }

        /* ---- 5. did either window close? ---------------------------- */
        if (Embed.GetValue(type="lua", name="quit") > 0.5) {
            Stdio.printf("\n[referee] the LUA window closed the match.\n");
            running = 0;
        }
        if (Embed.GetValue(type="python", name="quit") > 0.5) {
            Stdio.printf("\n[referee] the PYTHON window closed the match.\n");
            running = 0;
        }

        Stdio.sleep(DT);
    }

    /* -----------------------------------------------------------------
     *  Shut down.  running = 0 makes both windows leave their own loops
     *  and close cleanly, and Embed.Stop waits for them to do it.
     * ---------------------------------------------------------------- */
    if (frame >= MAX_FRAMES) {
        Stdio.printf("\n[referee] the {} frame backstop was reached.\n", MAX_FRAMES);
    }

    Stdio.printf("\n[referee] stopping the courts...\n");
    Embed.SendValue(type="lua", name="running", value=0);
    Embed.SendValue(type="python", name="running", value=0);
    Embed.Stop(type="lua");
    Embed.Stop(type="python");

    Stdio.printf("[referee] final score  LUA {} : {} PYTHON\n", lua_score, py_score);
    if (winner == 1) {
        Stdio.printf("[referee] LUA left with the trophy.\n");
    } else if (winner == 2) {
        Stdio.printf("[referee] PYTHON left with the trophy.\n");
    } else {
        Stdio.printf("[referee] match abandoned mid-rally.\n");
    }
    Stdio.printf("[referee] done.\n");
    return 0;
}
