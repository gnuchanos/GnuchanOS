#native <Stdio>
#native <Raylib>
#native <Raygui>

/* Raygui runtime testi — PENCERE ACAR (bir kare cizip kapanir). Cikis kodu = basarisiz
   kontrol sayisi, yani test kendi kendini dogrular.

   Amac: raygui modulu ile Raylib modulu AYNI raylib ornegini paylasiyor mu, ve
   kontrol out-parametreleri gercekten geri yaziliyor mu. Raygui.dll kendi raylib
   kopyasini statik linkliyor; o kopya InitWindow gormedigi icin varsayilan font
   kurulmamis olur. Asagidaki 3. kontrol bunu olcer.

   Kapsam:
     1. Sabitler (Raygui.DEFAULT, TEXT_SIZE, BUTTON, ICON_FILE_OPEN) kayitli mi.
     2. GuiSetStyle/GuiGetStyle yuvarlak yolculuk (raygui ic durumu).
     3. GuiGetTextWidth canli raylib varsayilan fontunu goruyor mu (paylasilan ornek).
     4. GuiProgressBar *value'yu kirpiyor mu -> out-parametre GERCEKTEN yaziliyor mu.
        Girdi 500, max 100 cikti 100 okunmali; sadece girdiyi yankilayan bir baglama
        bu kontrolu gecemez.
     5. GuiSlider / GuiCheckBox / GuiListViewEx durum okuma (LastFloat/Bool/Int/V2X).
     6. GuiIconText string out-parametresi (g_str -> LastStringLen). */

int fails = 0;

void check(int cond, char *name) {
    global fails;
    if (cond) {
        Stdio.printf("  PASS  {}\n", name);
    } else {
        Stdio.printf("  FAIL  {}\n", name);
        fails = fails + 1;
    }
}

void check_num(int cond, char *name, double got, double want) {
    global fails;
    if (cond) {
        Stdio.printf("  PASS  {} = {}\n", name, got);
    } else {
        Stdio.printf("  FAIL  {} got={} want={}\n", name, got, want);
        fails = fails + 1;
    }
}

int main() {
    Raylib.SetTraceLogLevel(Raylib.LOG_ERROR);
    Raylib.InitWindow(360, 260, "raygui runtime test");
    Raylib.SetTargetFPS(60);

    Stdio.printf("raygui runtime test\n");

    Raylib.BeginDrawing();
    Raylib.ClearBackground(Raylib.RAYWHITE);

    /* 1. Sabitler raygui.h sirasindan. */
    check(Raygui.DEFAULT == 0, "constant DEFAULT == 0");
    check(Raygui.TEXT_SIZE == 16, "constant TEXT_SIZE == 16");
    check(Raygui.BUTTON != 0, "constant BUTTON registered");
    check(Raygui.ICON_FILE_OPEN > 0, "constant ICON_FILE_OPEN registered");

    /* 2. Stil yuvarlak yolculuk: raygui'nin kendi durum dizisine yazip okuyoruz. */
    int before_style = Raygui.GuiGetStyle(Raygui.DEFAULT, Raygui.TEXT_SIZE);
    Raygui.GuiSetStyle(Raygui.DEFAULT, Raygui.TEXT_SIZE, 20);
    int after_style = Raygui.GuiGetStyle(Raygui.DEFAULT, Raygui.TEXT_SIZE);
    check_num(after_style == 20 && before_style != 20,
              "GuiSetStyle/GuiGetStyle round-trip", after_style, 20);
    Raygui.GuiSetStyle(Raygui.DEFAULT, Raygui.TEXT_SIZE, 16);

    /* 3. Paylasilan raylib ornegi. Ayrı bir statik raylib kopyasi olsaydi varsayilan
       font kurulmamis olurdu ve MeasureTextEx 0 donerdi. */
    int tw = Raygui.GuiGetTextWidth("MMMMMMMMMM");
    check_num(tw > 0, "GuiGetTextWidth sees live raylib default font", tw, 1);

    /* 4. Out-parametre gercek mi. GuiProgressBar: "if (*value > maxValue) *value = maxValue;"
       Girdi 500 -> cikti 100 zorunlu; girdiyi yankilayan baglama 500 okur ve duser. */
    float bar_hi = 500;
    Raygui.GuiProgressBar(10, 10, 200, 20, "", "", bar_hi, 0, 100);
    check_num(Raygui.LastFloat() == 100,
              "GuiProgressBar clamps out-param 500 -> 100", Raygui.LastFloat(), 100);

    /* Aralik ici deger kirpilmadan gecmeli (alt sinir kirpma raygui'de yok). */
    float bar_lo = -25;
    Raygui.GuiProgressBar(10, 10, 200, 20, "", "", bar_lo, 0, 100);
    check_num(Raygui.LastFloat() == -25,
              "GuiProgressBar passes in-range value through", Raygui.LastFloat(), -25);

    /* 5a. GuiSlider: bounds(0-3) textLeft(4) textRight(5) value(6) min(7) max(8). */
    float slider_value = 50;
    Raygui.GuiSlider(10, 40, 300, 30, "left", "right", slider_value, 0, 100);
    check_num(Raygui.LastFloat() == 50,
              "GuiSlider reads back value", Raygui.LastFloat(), 50);

    /* 5b. GuiCheckBox: bounds(0-3) text(4) checked(5). */
    Raygui.GuiCheckBox(10, 80, 30, 30, "on", 1);
    check_num(Raygui.LastBool() == 1,
              "GuiCheckBox reads back checked", Raygui.LastBool(), 1);

    /* 5c. GuiListViewEx: bounds(0-3) adet(4) metinler(5..7) scroll(8) active(9) focus(10).
       Durum ciktilari: active -> LastInt, scroll -> LastV2X, focus -> LastV2Y. */
    Raygui.GuiListViewEx(10, 120, 300, 100, 3, "bir", "iki", "uc", 1, 2, 0);
    check_num(Raygui.LastInt() == 2,
              "GuiListViewEx reads back active", Raygui.LastInt(), 2);
    Stdio.printf("  info  list scroll={} focus={}\n",
                 Raygui.LastV2X(), Raygui.LastV2Y());

    /* 6. String out-parametresi: GuiIconText sonucu g_str'ye yazilir. */
    Raygui.GuiIconText(Raygui.ICON_FILE_OPEN, "Open");
    check_num(Raygui.LastStringLen() > 0,
              "GuiIconText writes string out-param", Raygui.LastStringLen(), 1);

    Raylib.EndDrawing();
    Raylib.CloseWindow();

    if (fails == 0) Stdio.printf("RESULT: ALL PASS\n");
    else Stdio.printf("RESULT: {} CHECK(S) FAILED\n", fails);
    return fails;
}
