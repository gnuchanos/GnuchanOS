#native <Stdio>
#native <Raylib>

/* Raylib modulu entegrasyon testi — pencere GEREKTIRMEZ.
   Kapsam:
     1. VrDeviceInfo kurucusu argumanlari gercekten yaziyor mu (read-back).
     2. LoadVrStereoConfig() argumansiz cagri en son VrDeviceInfo'yu kullaniyor mu.
     3. LoadVrStereoConfig(...) duz argumanlarla da calisiyor mu.
     4. VrStereoConfig cikti matrisleri/çiftleri okunabiliyor mu.
     5. Metin/kod-noktasi koprusu (g_str + LastString*) calisiyor mu. */

int main() {
    /* --- 1. VrDeviceInfo kurucusu + read-back --- */
    Raylib.VrDeviceInfo(2160, 1200, 0.13, 0.07, 0.08, 0.063, 0.064);
    Stdio.printf("vrdev hres={} vres={} ipd={}\n",
                 Raylib.LastVrDevHRes(), Raylib.LastVrDevVRes(), Raylib.LastVrDevIpd());
    Stdio.printf("vrdev lens0={} chroma0={}\n",
                 Raylib.LastVrDevLensDistortion(0), Raylib.LastVrDevChromaAb(0));

    /* Opsiyonel 8 deger de yazilmali: lensDistortionValues[0..3],
       chromaAbCorrection[0..3] */
    Raylib.VrDeviceInfo(2160, 1200, 0.13, 0.07, 0.08, 0.063, 0.064,
                        1.0, 0.22, 0.24, 0.0,
                        0.996, -0.004, 1.014, 0.0);
    Stdio.printf("vrdev lens2={} chroma2={}\n",
                 Raylib.LastVrDevLensDistortion(2), Raylib.LastVrDevChromaAb(2));

    /* --- 2. Argumansiz LoadVrStereoConfig yukaridaki cihazi kullanir --- */
    Raylib.LoadVrStereoConfig();
    Stdio.printf("proj00={} pair0={}\n",
                 Raylib.LastVrProjection(0, 0), Raylib.LastVrPair(0));

    /* --- 3. Duz argumanli cagri (yalnizca 7 zorunlu arguman) --- */
    Raylib.LoadVrStereoConfig(2160, 1200, 0.13, 0.07, 0.08, 0.063, 0.064);
    Stdio.printf("viewoff0={} scale0_no_coeffs={}\n",
                 Raylib.LastVrViewOffset(0, 0), Raylib.LastVrPair(8));

    /* --- 4. scale, lens distorsiyon katsayilarindan hesaplanir (raylib rcore.c):
             lensRadius      = fabs(-1 - 4*lensShift)
             distortionScale = LDV[0] + LDV[1]*r^2 + LDV[2]*r^4 + LDV[3]*r^6
             scale[0]        = 0.25 / distortionScale
           Katsayilar (LDV) verilmezse polinom 0 olur ve raylib 0'a BOLER, yani
           scale = inf cikar. Bu bir okuma hatasi DEGIL, cagrinin dogal sonucudur.
           Katsayilari tasiyan VrDeviceInfo + argumansiz cagri sonlu scale uretir.
           Iki satiri karsilastirmak inf'in nereden geldigini kesinlestirir. */
    Raylib.LoadVrStereoConfig();
    Stdio.printf("scale0_with_coeffs={}\n", Raylib.LastVrPair(8));

    /* --- 5. Metin / kod noktasi koprusu --- */
    Stdio.printf("cpcount={}\n", Raylib.GetCodepointCount("AB"));
    Raylib.TextToUpper("abc");
    Stdio.printf("upper len={} upper byte0={}\n",
                 Raylib.LastStringLen(), Raylib.LastStringByte(0));

    return 0;
}
