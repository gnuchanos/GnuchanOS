#native <Stdio>
#native <Raylib>

/* Ses callback köprüsü testi — ÜRETİM tarafı.
   Ses callback'i AYRI iş parçacığında koştuğu için orada GCL çalıştırılamaz.
   Bu yüzden örnekler ana iş parçacığında, gcl_module_tick içinde üretilir:
   runtime her native modül çağrısından önce tick'i çalıştırır; tick, tampon
   azaldığında bu GCL fonksiyonunu host->call_gcl ile çağırır. Fonksiyon
   Raylib.AudioPush(v) ile halka tampona örnek basar; gerçek zamanlı
   trambolin (ses iş parçacığı) yalnızca bu tamponu boşaltır. */

int genCalls = 0;
int genFrames = 0;

void onAudio(int frames) {
    int i = 0;
    genCalls = genCalls + 1;
    genFrames = frames;
    while (i < frames) {
        Raylib.AudioPush(0.25);
        i = i + 1;
    }
}

int main() {
    /* Akış handle'ı -1: gerçek ses cihazı olmadan da üretim yolu (tick →
       GCL → AudioPush → tampon) çalışır; trambolin yalnızca ses cihazı
       varken ses iş parçacığından çağrılır. */
    Raylib.SetAudioStreamCallback(-1, "onAudio");

    /* Her native çağrı tick'i tetikler; printf bu yüzden üretimi başlatır. */
    Stdio.printf("queued={} genCalls={} frames={}\n",
                 Raylib.AudioQueued(), genCalls, genFrames);

    /* İkinci tur: tampon yeterince dolu olduğu için ÜRETİM YAPILMAMALI. */
    Stdio.printf("tekrar queued={} genCalls={}\n",
                 Raylib.AudioQueued(), genCalls);

    /* Ayırma: callback kaldırılınca üretim de durmalı. */
    Raylib.SetAudioStreamCallback(-1, "");
    Stdio.printf("detach-sonrasi genCalls={}\n", genCalls);
    return 0;
}
