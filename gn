#!/usr/bin/env python3
"""Convert an XWD dump to a PNG so a capture can be looked at directly.

Header is 25 big-endian 32-bit words, then the colour map, then the pixels
with a row stride the header names. Direct colour only, downscaled by an
integer step so the result is small enough to look at.
"""
import struct
import sys
import zlib

src = sys.argv[1]
dst = sys.argv[2]
step = int(sys.argv[3]) if len(sys.argv) > 3 else 1

with open(src, "rb") as handle:
    data = handle.read()

f = struct.unpack(">25I", data[0:100])
header_size = f[0]
sw = f[4]
sh = f[5]
bpp = f[11]
bytes_per_line = f[12]
red_mask = f[14]
green_mask = f[15]
blue_mask = f[16]
ncolors = f[19]

pixel_start = header_size + ncolors * 12
bpp_bytes = max(1, bpp // 8)


def shift_of(mask):
    return (mask & -mask).bit_length() - 1


def bits_of(mask):
    return bin(mask).count("1")


rs, gs, bs = shift_of(red_mask), shift_of(green_mask), shift_of(blue_mask)
rb, gb, bb = bits_of(red_mask), bits_of(green_mask), bits_of(blue_mask)


def to8(value, bits):
    if bits <= 0:
        return 0
    return value >> (bits - 8) if bits >= 8 else value << (8 - bits)


def pixel(x, y):
    off = pixel_start + y * bytes_per_line + x * bpp_bytes
    value = int.from_bytes(data[off:off + bpp_bytes], "little")
    return (to8((value & red_mask) >> rs, rb),
            to8((value & green_mask) >> gs, gb),
            to8((value & blue_mask) >> bs, bb))


width = sw // step
height = sh // step
raw = bytearray()
for oy in range(height):
    raw.append(0)
    y = oy * step
    for ox in range(width):
        r, g, b = pixel(ox * step, y)
        raw.append(r)
        raw.append(g)
        raw.append(b)


def chunk(name, body):
    return (struct.pack(">I", len(body)) + name + body +
            struct.pack(">I", zlib.crc32(name + body) & 0xffffffff))


out = b"\x89PNG\r\n\x1a\n"
out += chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
out += chunk(b"IDAT", zlib.compress(bytes(raw), 6))
out += chunk(b"IEND", b"")

with open(dst, "wb") as handle:
    handle.write(out)

print("wrote %s: %dx%d from %dx%d step=%d" % (dst, width, height, sw, sh, step))
