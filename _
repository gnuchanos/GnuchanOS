#!/bin/bash
export SSHPASS='Kubilay2232'
H="archkubi@192.168.1.104"
S="sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR"
C="sshpass -e scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR"
PW='Kubilay2232'

# Push the updated settings script (with BackgroundImage) and the picture.
$C -q /mnt/d/GnuchanOS/gnuchan_softwares/gcl_WM/GnuChanWM_config/GnuChanWM.py "$H:/tmp/GnuChanWM.py" && echo pushed-config
$C -q /mnt/d/GnuchanOS/assets/bg.png "$H:/tmp/bg.png" && echo pushed-bg

$S "$H" "echo '$PW' | sudo -S -p '' bash -c '
install -o archkubi -g archkubi -m 644 /tmp/GnuChanWM.py /home/archkubi/.config/GnuChanWM/GnuChanWM.py
install -o archkubi -g archkubi -m 644 /tmp/bg.png /home/archkubi/.config/GnuChanWM/bg.png
grep -n BackgroundImage /home/archkubi/.config/GnuChanWM/GnuChanWM.py
pkill -x GnuChanWM 2>/dev/null; sleep 2
DISPLAY=:0 XAUTHORITY=/run/gnuchandm/auth HOME=/home/archkubi setsid /usr/local/bin/GnuChanWM >/tmp/wm6.log 2>&1 </dev/null &
sleep 8
pgrep -x GnuChanWM
grep -iE \"image|wallpaper|not found|could not\" /tmp/wm6.log | tail -5 || echo \"(no image error)\"
'" 2>&1

$S "$H" "echo '$PW' | sudo -S -p '' bash -c 'DISPLAY=:0 XAUTHORITY=/run/gnuchandm/auth xwd -root -silent -out /tmp/w6.xwd; chmod 644 /tmp/w6.xwd'" 2>&1
rm -f /tmp/w6.xwd
$C -q "$H:/tmp/w6.xwd" /tmp/ 2>/dev/null
echo "pulled $(stat -c%s /tmp/w6.xwd 2>/dev/null)"
