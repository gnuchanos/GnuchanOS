# ── Line ending policy ─────────────────────────────────────
# Keep files in LF form in the repo even if edited on Windows.
# Otherwise scripts break in Linux/CI due to CRLF line endings (shebang breaks).

* text=auto

# Shell and boot scripts must always use LF
*.sh      text eol=lf
# The live ISO's build tree (distro/). These files are executed: build.sh
# configures and builds, and live-build runs config/hooks/*.chroot inside the
# image. A CRLF checkout would break every shebang (a "#!/bin/sh\r" is a
# different interpreter name) and leave the hooks unrunnable, so they are
# pinned to LF regardless of the platform they are edited on.
distro/build.sh            text eol=lf
*.hook.chroot              text eol=lf
os/boot/init    text eol=lf
os/boot/initrc  text eol=lf
os/boot/inittab text eol=lf
os/boot/grub.cfg    text eol=lf
os/boot/os-release  text eol=lf
os/build/gnuchanos-build.conf text eol=lf
.github/workflows/*.yml text eol=lf
