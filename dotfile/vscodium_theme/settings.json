    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "source",
                    "text",
                    "meta",
                    "punctuation",
                    "punctuation.definition",
                    "punctuation.separator",
                    "punctuation.accessor",
                    "meta.brace",
                    "meta.delimiter"
                ],
                "settings": {
                    "foreground": "#B78ED6"
                }
            },
            {
                "scope": [
                    "comment",
                    "comment.block",
                    "comment.line",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "foreground": "#70458A"
                }
            },
            {
                "scope": [
                    "keyword",
                    "keyword.control",
                    "keyword.operator",
                    "keyword.other",
                    "storage",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "foreground": "#C77DFF"
                }
            },
            {
                "scope": [
                    "string",
                    "string.quoted",
                    "string.quoted.single",
                    "string.quoted.double",
                    "string.template",
                    "string.interpolated"
                ],
                "settings": {
                    "foreground": "#B76EFF"
                }
            },
            {
                "scope": [
                    "constant",
                    "constant.numeric",
                    "constant.language",
                    "constant.character",
                    "constant.other"
                ],
                "settings": {
                    "foreground": "#D8A4FF"
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "support.function",
                    "meta.function-call",
                    "variable.function"
                ],
                "settings": {
                    "foreground": "#E0AAFF"
                }
            },
            {
                "scope": [
                    "entity.name.class",
                    "entity.name.type",
                    "entity.name.type.class",
                    "entity.other.inherited-class",
                    "support.type"
                ],
                "settings": {
                    "foreground": "#D8A4FF"
                }
            },
            {
                "scope": [
                    "variable",
                    "variable.other",
                    "variable.parameter",
                    "variable.other.readwrite"
                ],
                "settings": {
                    "foreground": "#EAD7FF"
                }
            },
            {
                "scope": [
                    "variable.language",
                    "support.variable"
                ],
                "settings": {
                    "foreground": "#C084FC"
                }
            },

            {
                "scope": [
                    "support.type.property-name.json",
                    "meta.structure.dictionary.json",
                    "meta.structure.dictionary.key.json",
                    "meta.object-literal.key",
                    "entity.name.tag.json",
                    "variable.other.property"
                ],
                "settings": {
                    "foreground": "#D8A4FF"
                }
            },
            {
                "scope": [
                    "string.quoted.double.json",
                    "string.quoted.json"
                ],
                "settings": {
                    "foreground": "#C084FC"
                }
            },
            {
                "scope": [
                    "constant.language.json",
                    "constant.numeric.json",
                    "constant.numeric"
                ],
                "settings": {
                    "foreground": "#B76EFF"
                }
            },
            {
                "scope": [
                    "punctuation.definition.string.begin.json",
                    "punctuation.definition.string.end.json",
                    "punctuation.support.type.property-name.begin.json",
                    "punctuation.support.type.property-name.end.json"
                ],
                "settings": {
                    "foreground": "#A855F7"
                }
            },

            {
                "scope": [
                    "entity.name.tag",
                    "punctuation.definition.tag"
                ],
                "settings": {
                    "foreground": "#C77DFF"
                }
            },
            {
                "scope": [
                    "entity.other.attribute-name"
                ],
                "settings": {
                    "foreground": "#D8A4FF"
                }
            },
            {
                "scope": [
                    "support.class",
                    "support.constant",
                    "support.type",
                    "support.other"
                ],
                "settings": {
                    "foreground": "#B76EFF"
                }
            },
            {
                "scope": [
                    "entity.name.namespace",
                    "entity.name.module"
                ],
                "settings": {
                    "foreground": "#C77DFF"
                }
            }
        ]
    },

    "editor.semanticHighlighting.enabled": true,

    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "variable": "#EAD7FF",
            "variable.readonly": "#D8A4FF",
            "variable.defaultLibrary": "#C084FC",
            "parameter": "#D0A8ED",
            "property": "#D8A4FF",
            "function": "#E0AAFF",
            "method": "#D8A4FF",
            "class": "#D8A4FF",
            "interface": "#C77DFF",
            "type": "#C77DFF",
            "enum": "#D8A4FF",
            "enumMember": "#B76EFF",
            "namespace": "#C77DFF",
            "typeParameter": "#D8A4FF",
            "decorator": "#B04CFF",
            "label": "#C77DFF",
            "macro": "#B04CFF",
            "event": "#D8A4FF",
            "modifier": "#C77DFF",
            "regexp": "#B76EFF"
        }
    }
}
