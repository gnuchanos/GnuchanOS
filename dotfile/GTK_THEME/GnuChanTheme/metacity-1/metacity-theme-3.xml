<?xml version="1.0"?>
<!-- GnuchanPurple - Metacity / Marco window manager theme

     Metacity and Marco (the MATE window manager) read this file for window
     decorations. Geometry is thin and flat, matching the GTK 3 and GTK 4 title
     bars so decorated and client side decorated windows look like one system.

     Palette is identical to the rest of the theme.
     License: GPL3.

     Note: an XML comment may not contain a double hyphen, so this header uses
     blank lines instead of a rule. Writing one here makes the whole file
     unparseable and Metacity silently falls back to its built in theme.

     The frame_style_sets below list normal, maximized and shaded windows for
     both focus states. There is no entry for the tiled or attached states:
     their names come from the theme schema in Metacity's own theme parser, and
     the format is not documented anywhere this repository can check without
     the Metacity source. A wrong token there does not degrade gracefully, it
     makes Metacity reject the whole file and fall back to its built in theme,
     which is worse than the current state; so those entries are left out
     until they can be verified against the parser. Metacity falls back to the
     closest listed state for a window it has no exact entry for, which for a
     tiled window is the normal frame, and that is what this theme draws today.
-->
<metacity_theme>
  <info>
    <name>GnuchanPurple</name>
    <author>GnuchanOS</author>
    <copyright>GPL3</copyright>
    <date>2026</date>
    <description>Dark purple window decorations for GnuchanOS</description>
  </info>

  <!-- Palette -->
  <constant name="C_bg"             value="#0e0614"/>
  <constant name="C_bg_darkest"     value="#09030d"/>
  <constant name="C_raised"         value="#1c0b27"/>
  <constant name="C_raised_hover"   value="#281036"/>
  <constant name="C_selected"       value="#542080"/>
  <constant name="C_border"         value="#32143f"/>
  <constant name="C_border_alt"     value="#24102f"/>
  <constant name="C_accent"         value="#a855f7"/>
  <constant name="C_fg"             value="#ead7ff"/>
  <constant name="C_fg_dim"         value="#b78ed6"/>
  <constant name="C_fg_disabled"    value="#70458a"/>
  <constant name="C_white"          value="#ffffff"/>
  <constant name="C_close"          value="#e879f9"/>
  <constant name="C_close_bg"       value="#86198f"/>
  <!-- The normal close state and the inactive button fill, kept in step with
       openbox-3/themerc and the xfwm4 images theme_install.py renders. -->
  <constant name="C_close_rest"     value="#2a0b2f"/>
  <constant name="C_button_inactive" value="#12071a"/>

  <!-- Frame geometries -->
  <frame_geometry name="normal" rounded_top_left="false" rounded_top_right="false"
                  rounded_bottom_left="false" rounded_bottom_right="false">
    <distance name="left_width" value="1"/>
    <distance name="right_width" value="1"/>
    <distance name="bottom_height" value="1"/>
    <distance name="left_titlebar_edge" value="1"/>
    <distance name="right_titlebar_edge" value="1"/>
    <distance name="button_width" value="24"/>
    <distance name="button_height" value="22"/>
    <distance name="title_vertical_pad" value="4"/>
    <distance name="titlebar_top_pad" value="0"/>
    <distance name="titlebar_bottom_pad" value="0"/>
    <border name="title_border" left="6" right="6" top="4" bottom="4"/>
    <border name="button_border" left="4" right="4" top="2" bottom="2"/>
    <!-- No aspect_ratio element: "titlebar" is the only name the schema
         accepts here, and the value was 0, which the parser accepts and the
         geometry code then ignores. The height comes from TITLE_HEIGHT in
         theme_install.py, which is what renders the xfwm4 title bar. -->
  </frame_geometry>

  <frame_geometry name="max" parent="normal" has_title="false">
    <distance name="title_vertical_pad" value="0"/>
  </frame_geometry>

  <frame_geometry name="border" parent="normal" has_title="false">
    <distance name="title_vertical_pad" value="0"/>
  </frame_geometry>

  <!-- Draw operations -->
  <draw_ops name="entire_background_active">
    <rectangle color="C_border" x="0" y="0" width="width" height="height" filled="true"/>
  </draw_ops>

  <draw_ops name="entire_background_inactive">
    <rectangle color="C_border_alt" x="0" y="0" width="width" height="height" filled="true"/>
  </draw_ops>

  <draw_ops name="titlebar_active">
    <rectangle color="C_bg_darkest" x="0" y="0" width="width" height="height" filled="true"/>
    <line color="C_border" x1="0" y1="height - 1" x2="width - 1" y2="height - 1"/>
  </draw_ops>

  <draw_ops name="titlebar_inactive">
    <rectangle color="C_bg_darkest" x="0" y="0" width="width" height="height" filled="true"/>
    <line color="C_border_alt" x1="0" y1="height - 1" x2="width - 1" y2="height - 1"/>
  </draw_ops>

  <draw_ops name="title_active">
    <title color="C_fg" x="0" y="(height - title_height) / 2" />
  </draw_ops>

  <draw_ops name="title_inactive">
    <title color="C_fg_dim" x="0" y="(height - title_height) / 2" />
  </draw_ops>
<!-- Title buttons. Flat rounded squares with hand drawn glyphs, so the theme
       needs no image files and the decorations stay crisp at any scale. -->
  <draw_ops name="button_background">
    <rectangle color="C_raised" x="0" y="0" width="width" height="height" filled="true"/>
    <rectangle color="C_border" x="0" y="0" width="width" height="height" filled="false"/>
  </draw_ops>

  <draw_ops name="button_background_hover">
    <rectangle color="C_raised_hover" x="0" y="0" width="width" height="height" filled="true"/>
    <rectangle color="C_accent" x="0" y="0" width="width" height="height" filled="false"/>
  </draw_ops>

  <draw_ops name="button_background_pressed">
    <rectangle color="C_selected" x="0" y="0" width="width" height="height" filled="true"/>
    <rectangle color="C_accent" x="0" y="0" width="width" height="height" filled="false"/>
  </draw_ops>

  <!-- C_bg was almost the same shade as the title bar, so an unfocused window
       showed nothing where its buttons are. This fill matches the inactive
       button colour in openbox-3/themerc, so the boxes stay visible. -->
  <draw_ops name="button_background_insensitive">
    <rectangle color="C_button_inactive" x="0" y="0" width="width" height="height" filled="true"/>
    <rectangle color="C_border_alt" x="0" y="0" width="width" height="height" filled="false"/>
  </draw_ops>

  <!-- Fill #2a0b2f, border and glyph #e879f9: the same normal close state as
       openbox-3/themerc and the xfwm4 close-active.png. -->
  <draw_ops name="button_close_background">
    <rectangle color="C_close_rest" x="0" y="0" width="width" height="height" filled="true"/>
    <rectangle color="C_close" x="0" y="0" width="width" height="height" filled="false"/>
  </draw_ops>

  <draw_ops name="button_close_background_hover">
    <rectangle color="C_close_bg" x="0" y="0" width="width" height="height" filled="true"/>
  </draw_ops>

  <draw_ops name="button_close_glyph">
    <line color="C_close" x1="(width / 2) - 4" y1="(height / 2) - 4"
          x2="(width / 2) + 4" y2="(height / 2) + 4"/>
    <line color="C_close" x1="(width / 2) + 4" y1="(height / 2) - 4"
          x2="(width / 2) - 4" y2="(height / 2) + 4"/>
  </draw_ops>

  <draw_ops name="button_close_glyph_hover">
    <line color="C_white" x1="(width / 2) - 4" y1="(height / 2) - 4"
          x2="(width / 2) + 4" y2="(height / 2) + 4"/>
    <line color="C_white" x1="(width / 2) + 4" y1="(height / 2) - 4"
          x2="(width / 2) - 4" y2="(height / 2) + 4"/>
  </draw_ops>

  <draw_ops name="button_max_glyph">
    <rectangle color="C_fg" x="(width / 2) - 4" y="(height / 2) - 4"
               width="9" height="9" filled="true"/>
  </draw_ops>

  <draw_ops name="button_unmax_glyph">
    <rectangle color="C_fg" x="(width / 2) - 5" y="(height / 2) - 3"
               width="9" height="9" filled="true"/>
    <rectangle color="C_bg_darkest" x="(width / 2) - 3" y="(height / 2) - 1"
               width="8" height="8" filled="true"/>
  </draw_ops>

  <draw_ops name="button_min_glyph">
    <line color="C_fg" x1="(width / 2) - 5" y1="(height / 2) + 3"
          x2="(width / 2) + 5" y2="(height / 2) + 3"/>
  </draw_ops>

  <draw_ops name="button_shade_glyph">
    <line color="C_fg" x1="(width / 2) - 5" y1="(height / 2)"
          x2="(width / 2) + 5" y2="(height / 2)"/>
    <line color="C_fg" x1="(width / 2) - 3" y1="(height / 2) + 3"
          x2="(width / 2) + 3" y2="(height / 2) + 3"/>
  </draw_ops>

  <draw_ops name="button_menu_glyph">
    <rectangle color="C_fg" x="(width / 2) - 5" y="(height / 2) - 4"
               width="11" height="2" filled="true"/>
    <rectangle color="C_fg" x="(width / 2) - 5" y="(height / 2)"
               width="11" height="2" filled="true"/>
    <rectangle color="C_fg" x="(width / 2) - 5" y="(height / 2) + 4"
               width="11" height="2" filled="true"/>
  </draw_ops>
  <!-- Dimmed glyphs for the unfocused state. Metacity draws a disabled button
       through its own draw_ops, so each symbol needs a variant in
       C_fg_disabled; without one the button box was drawn empty. -->
  <draw_ops name="button_close_glyph_insensitive">
    <line color="C_fg_disabled" x1="(width / 2) - 4" y1="(height / 2) - 4"
          x2="(width / 2) + 4" y2="(height / 2) + 4"/>
    <line color="C_fg_disabled" x1="(width / 2) + 4" y1="(height / 2) - 4"
          x2="(width / 2) - 4" y2="(height / 2) + 4"/>
  </draw_ops>

  <draw_ops name="button_max_glyph_insensitive">
    <rectangle color="C_fg_disabled" x="(width / 2) - 4" y="(height / 2) - 4"
               width="9" height="9" filled="true"/>
  </draw_ops>

  <draw_ops name="button_unmax_glyph_insensitive">
    <rectangle color="C_fg_disabled" x="(width / 2) - 5" y="(height / 2) - 3"
               width="9" height="9" filled="true"/>
    <rectangle color="C_button_inactive" x="(width / 2) - 3" y="(height / 2) - 1"
               width="8" height="8" filled="true"/>
  </draw_ops>

  <draw_ops name="button_min_glyph_insensitive">
    <line color="C_fg_disabled" x1="(width / 2) - 5" y1="(height / 2) + 3"
          x2="(width / 2) + 5" y2="(height / 2) + 3"/>
  </draw_ops>

  <draw_ops name="button_shade_glyph_insensitive">
    <line color="C_fg_disabled" x1="(width / 2) - 5" y1="(height / 2)"
          x2="(width / 2) + 5" y2="(height / 2)"/>
    <line color="C_fg_disabled" x1="(width / 2) - 3" y1="(height / 2) + 3"
          x2="(width / 2) + 3" y2="(height / 2) + 3"/>
  </draw_ops>

  <draw_ops name="button_menu_glyph_insensitive">
    <rectangle color="C_fg_disabled" x="(width / 2) - 5" y="(height / 2) - 4"
               width="11" height="2" filled="true"/>
    <rectangle color="C_fg_disabled" x="(width / 2) - 5" y="(height / 2)"
               width="11" height="2" filled="true"/>
    <rectangle color="C_fg_disabled" x="(width / 2) - 5" y="(height / 2) + 4"
               width="11" height="2" filled="true"/>
  </draw_ops>
<!-- Composite button draw operations -->
  <draw_ops name="close_normal">
    <include name="button_close_background"/>
    <include name="button_close_glyph"/>
  </draw_ops>

  <draw_ops name="close_hover">
    <include name="button_close_background_hover"/>
    <include name="button_close_glyph_hover"/>
  </draw_ops>

  <draw_ops name="close_pressed">
    <include name="button_background_pressed"/>
    <include name="button_close_glyph_hover"/>
  </draw_ops>

  <!-- One insensitive composite per button function, each pairing the inactive
       box with its own dimmed glyph. The unfocused frame styles used to point
       every function at close_insensitive, which drew a bare box. -->
  <draw_ops name="close_insensitive">
    <include name="button_background_insensitive"/>
    <include name="button_close_glyph_insensitive"/>
  </draw_ops>

  <draw_ops name="maximize_insensitive">
    <include name="button_background_insensitive"/>
    <include name="button_max_glyph_insensitive"/>
  </draw_ops>

  <draw_ops name="unmaximize_insensitive">
    <include name="button_background_insensitive"/>
    <include name="button_unmax_glyph_insensitive"/>
  </draw_ops>

  <draw_ops name="minimize_insensitive">
    <include name="button_background_insensitive"/>
    <include name="button_min_glyph_insensitive"/>
  </draw_ops>

  <draw_ops name="shade_insensitive">
    <include name="button_background_insensitive"/>
    <include name="button_shade_glyph_insensitive"/>
  </draw_ops>

  <draw_ops name="menu_insensitive">
    <include name="button_background_insensitive"/>
    <include name="button_menu_glyph_insensitive"/>
  </draw_ops>

  <draw_ops name="maximize_normal">
    <include name="button_background"/>
    <include name="button_max_glyph"/>
  </draw_ops>

  <draw_ops name="maximize_hover">
    <include name="button_background_hover"/>
    <include name="button_max_glyph"/>
  </draw_ops>

  <draw_ops name="maximize_pressed">
    <include name="button_background_pressed"/>
    <include name="button_max_glyph"/>
  </draw_ops>

  <draw_ops name="unmaximize_normal">
    <include name="button_background"/>
    <include name="button_unmax_glyph"/>
  </draw_ops>

  <draw_ops name="unmaximize_hover">
    <include name="button_background_hover"/>
    <include name="button_unmax_glyph"/>
  </draw_ops>

  <draw_ops name="unmaximize_pressed">
    <include name="button_background_pressed"/>
    <include name="button_unmax_glyph"/>
  </draw_ops>

  <draw_ops name="minimize_normal">
    <include name="button_background"/>
    <include name="button_min_glyph"/>
  </draw_ops>

  <draw_ops name="minimize_hover">
    <include name="button_background_hover"/>
    <include name="button_min_glyph"/>
  </draw_ops>

  <draw_ops name="minimize_pressed">
    <include name="button_background_pressed"/>
    <include name="button_min_glyph"/>
  </draw_ops>

  <draw_ops name="shade_normal">
    <include name="button_background"/>
    <include name="button_shade_glyph"/>
  </draw_ops>

  <draw_ops name="shade_hover">
    <include name="button_background_hover"/>
    <include name="button_shade_glyph"/>
  </draw_ops>

  <draw_ops name="shade_pressed">
    <include name="button_background_pressed"/>
    <include name="button_shade_glyph"/>
  </draw_ops>

  <draw_ops name="menu_normal">
    <include name="button_background"/>
    <include name="button_menu_glyph"/>
  </draw_ops>

  <draw_ops name="menu_hover">
    <include name="button_background_hover"/>
    <include name="button_menu_glyph"/>
  </draw_ops>

  <draw_ops name="menu_pressed">
    <include name="button_background_pressed"/>
    <include name="button_menu_glyph"/>
  </draw_ops>

  <!-- Frame styles -->
  <frame_style name="normal_focused" geometry="normal">
    <piece position="entire_background" draw_ops="entire_background_active"/>
    <piece position="titlebar" draw_ops="titlebar_active"/>
    <piece position="title" draw_ops="title_active"/>
    <button function="close" state="normal" draw_ops="close_normal"/>
    <button function="close" state="pressed" draw_ops="close_pressed"/>
    <button function="close" state="prelight" draw_ops="close_hover"/>
    <button function="close" state="disabled" draw_ops="close_insensitive"/>
    <button function="maximize" state="normal" draw_ops="maximize_normal"/>
    <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
    <button function="maximize" state="prelight" draw_ops="maximize_hover"/>
    <button function="unmaximize" state="normal" draw_ops="unmaximize_normal"/>
    <button function="unmaximize" state="pressed" draw_ops="unmaximize_pressed"/>
    <button function="unmaximize" state="prelight" draw_ops="unmaximize_hover"/>
    <button function="minimize" state="normal" draw_ops="minimize_normal"/>
    <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
    <button function="minimize" state="prelight" draw_ops="minimize_hover"/>
    <button function="shade" state="normal" draw_ops="shade_normal"/>
    <button function="shade" state="pressed" draw_ops="shade_pressed"/>
    <button function="shade" state="prelight" draw_ops="shade_hover"/>
    <button function="unshade" state="normal" draw_ops="shade_normal"/>
    <button function="unshade" state="pressed" draw_ops="shade_pressed"/>
    <button function="unshade" state="prelight" draw_ops="shade_hover"/>
    <button function="menu" state="normal" draw_ops="menu_normal"/>
    <button function="menu" state="pressed" draw_ops="menu_pressed"/>
    <button function="menu" state="prelight" draw_ops="menu_hover"/>
  </frame_style>

  <frame_style name="normal_unfocused" geometry="normal">
    <piece position="entire_background" draw_ops="entire_background_inactive"/>
    <piece position="titlebar" draw_ops="titlebar_inactive"/>
    <piece position="title" draw_ops="title_inactive"/>
    <button function="close" state="normal" draw_ops="close_insensitive"/>
    <button function="close" state="pressed" draw_ops="close_pressed"/>
    <button function="close" state="prelight" draw_ops="close_hover"/>
    <button function="close" state="disabled" draw_ops="close_insensitive"/>
    <button function="maximize" state="normal" draw_ops="maximize_insensitive"/>
    <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
    <button function="maximize" state="prelight" draw_ops="maximize_hover"/>
    <button function="unmaximize" state="normal" draw_ops="unmaximize_insensitive"/>
    <button function="unmaximize" state="pressed" draw_ops="unmaximize_pressed"/>
    <button function="unmaximize" state="prelight" draw_ops="unmaximize_hover"/>
    <button function="minimize" state="normal" draw_ops="minimize_insensitive"/>
    <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
    <button function="minimize" state="prelight" draw_ops="minimize_hover"/>
    <button function="shade" state="normal" draw_ops="shade_insensitive"/>
    <button function="shade" state="pressed" draw_ops="shade_pressed"/>
    <button function="shade" state="prelight" draw_ops="shade_hover"/>
    <button function="unshade" state="normal" draw_ops="shade_insensitive"/>
    <button function="unshade" state="pressed" draw_ops="shade_pressed"/>
    <button function="unshade" state="prelight" draw_ops="shade_hover"/>
    <button function="menu" state="normal" draw_ops="menu_insensitive"/>
    <button function="menu" state="pressed" draw_ops="menu_pressed"/>
    <button function="menu" state="prelight" draw_ops="menu_hover"/>
  </frame_style>

  <frame_style name="max_focused" geometry="max">
    <piece position="entire_background" draw_ops="entire_background_active"/>
    <piece position="titlebar" draw_ops="titlebar_active"/>
    <button function="close" state="normal" draw_ops="close_normal"/>
    <button function="close" state="pressed" draw_ops="close_pressed"/>
    <button function="close" state="prelight" draw_ops="close_hover"/>
    <button function="unmaximize" state="normal" draw_ops="unmaximize_normal"/>
    <button function="unmaximize" state="pressed" draw_ops="unmaximize_pressed"/>
    <button function="unmaximize" state="prelight" draw_ops="unmaximize_hover"/>
    <button function="minimize" state="normal" draw_ops="minimize_normal"/>
    <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
    <button function="minimize" state="prelight" draw_ops="minimize_hover"/>
    <button function="menu" state="normal" draw_ops="menu_normal"/>
    <button function="menu" state="pressed" draw_ops="menu_pressed"/>
    <button function="menu" state="prelight" draw_ops="menu_hover"/>
  </frame_style>

  <frame_style name="max_unfocused" geometry="max">
    <piece position="entire_background" draw_ops="entire_background_inactive"/>
    <piece position="titlebar" draw_ops="titlebar_inactive"/>
    <button function="close" state="normal" draw_ops="close_insensitive"/>
    <button function="close" state="pressed" draw_ops="close_pressed"/>
    <button function="close" state="prelight" draw_ops="close_hover"/>
    <button function="unmaximize" state="normal" draw_ops="unmaximize_insensitive"/>
    <button function="unmaximize" state="pressed" draw_ops="unmaximize_pressed"/>
    <button function="unmaximize" state="prelight" draw_ops="unmaximize_hover"/>
    <button function="minimize" state="normal" draw_ops="minimize_insensitive"/>
    <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
    <button function="minimize" state="prelight" draw_ops="minimize_hover"/>
    <button function="menu" state="normal" draw_ops="menu_insensitive"/>
    <button function="menu" state="pressed" draw_ops="menu_pressed"/>
    <button function="menu" state="prelight" draw_ops="menu_hover"/>
  </frame_style>

  <frame_style name="border_focused" geometry="border">
    <piece position="entire_background" draw_ops="entire_background_active"/>
  </frame_style>

  <frame_style name="border_unfocused" geometry="border">
    <piece position="entire_background" draw_ops="entire_background_inactive"/>
  </frame_style>
<!-- Style sets -->
  <frame_style_set name="normal">
    <frame focus="yes" state="normal" resize="both" style="normal_focused"/>
    <frame focus="no" state="normal" resize="both" style="normal_unfocused"/>
    <frame focus="yes" state="maximized" style="max_focused"/>
    <frame focus="no" state="maximized" style="max_unfocused"/>
    <frame focus="yes" state="shaded" style="normal_focused"/>
    <frame focus="no" state="shaded" style="normal_unfocused"/>
    <frame focus="yes" state="maximized_and_shaded" style="max_focused"/>
    <frame focus="no" state="maximized_and_shaded" style="max_unfocused"/>
  </frame_style_set>

  <frame_style_set name="border">
    <frame focus="yes" state="normal" resize="both" style="border_focused"/>
    <frame focus="no" state="normal" resize="both" style="border_unfocused"/>
    <frame focus="yes" state="maximized" style="border_focused"/>
    <frame focus="no" state="maximized" style="border_unfocused"/>
    <frame focus="yes" state="shaded" style="border_focused"/>
    <frame focus="no" state="shaded" style="border_unfocused"/>
  </frame_style_set>

  <!-- Window types -->
  <window type="normal" style_set="normal"/>
  <window type="dialog" style_set="normal"/>
  <window type="modal_dialog" style_set="normal"/>
  <window type="menu" style_set="normal"/>
  <window type="utility" style_set="normal"/>
  <window type="border" style_set="border"/>

  <!-- Window menu glyphs drawn by the window manager -->
  <menu_icon function="close" state="normal" draw_ops="button_close_glyph"/>
  <menu_icon function="maximize" state="normal" draw_ops="button_max_glyph"/>
  <menu_icon function="unmaximize" state="normal" draw_ops="button_unmax_glyph"/>
  <menu_icon function="minimize" state="normal" draw_ops="button_min_glyph"/>
  <menu_icon function="menu" state="normal" draw_ops="button_menu_glyph"/>

  <!-- Colours used for the window menu itself -->
  <draw_ops name="menu_background">
    <rectangle color="C_raised" x="0" y="0" width="width" height="height" filled="true"/>
    <rectangle color="C_border" x="0" y="0" width="width" height="height" filled="false"/>
  </draw_ops>

  <draw_ops name="menu_frame">
    <include name="menu_background"/>
  </draw_ops>

  <draw_ops name="menu_item">
    <rectangle color="C_raised" x="0" y="0" width="width" height="height" filled="true"/>
  </draw_ops>

  <draw_ops name="menu_item_prelight">
    <rectangle color="C_selected" x="0" y="0" width="width" height="height" filled="true"/>
  </draw_ops>

  <draw_ops name="menu_separator">
    <line color="C_border" x1="0" y1="0" x2="width - 1" y2="0"/>
  </draw_ops>

  <menu_style name="normal">
    <piece position="entire_background" draw_ops="menu_background"/>
    <piece position="frame" draw_ops="menu_frame"/>
    <piece position="item" draw_ops="menu_item"/>
    <piece position="item_prelight" draw_ops="menu_item_prelight"/>
    <piece position="separator" draw_ops="menu_separator"/>
  </menu_style>

  <menu_style_set name="normal">
    <menu state="normal" style="normal"/>
    <menu state="prelight" style="normal"/>
    <menu state="active" style="normal"/>
    <menu state="insensitive" style="normal"/>
  </menu_style_set>

  <window_style_set name="normal">
    <window state="normal" menu_style_set="normal"/>
  </window_style_set>
</metacity_theme>
