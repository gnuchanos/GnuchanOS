! ============================================================================
! GnuchanPurple - X11 resources
! ----------------------------------------------------------------------------
! Load with:  xrdb -merge ~/.config/gnuchan-purple/Xresources
!
! Covers the classic X colours (*.color0 .. *.color15) that xterm, urxvt,
! st, xfontsel and many small X programs read, plus the cursor colour pair.
!
! The sixteen ANSI slots are the ones dotfile/vscodium_theme/settings.json
! gives to terminal.ansiBlack .. terminal.ansiBrightWhite, so VSCodium's
! integrated terminal and xterm show the same colours. That palette file is
! the source of truth: change it there first, then copy the values here, to
! kitty.conf and to alacritty.toml.
!
! License: GPL3
! ============================================================================

! Special
*foreground:     #ead7ff
*background:     #09030d
*cursorColor:    #ddb3ff
*pointerColorBackground: #32143f
*pointerColorForeground: #c77dff

! Black / bright black
*color0:  #170a20
*color8:  #70458a

! Red
*color1:  #c084fc
*color9:  #d8a4ff

! Green
*color2:  #b56cff
*color10: #c084fc

! Yellow
*color3:  #d8a4ff
*color11: #e0aaff

! Blue
*color4:  #9d4edd
*color12: #b76eff

! Magenta
*color5:  #c77dff
*color13: #e0aaff

! Cyan
*color6:  #b76eff
*color14: #d8a4ff

! White / bright white
*color7:  #ead7ff
*color15: #ffffff

! Text selection
*highlightColor:   #ead7ff
*highlightColorBG: #542080

! Selection colours for widgets
*selectBackground: #542080
*selectForeground: #ffffff
*selectColor:      #542080
*menuBackground:   #180a22
*menuForeground:   #ead7ff
*menuHighlight:    #542080
*menuShadowColor:  #000000
*menuBorderColor:  #6d28d9
